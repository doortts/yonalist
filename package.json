    "@unicode/unicode-17.0.0": "^1.6.17",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
