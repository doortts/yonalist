    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.24.0",
    "markdown-it": "^14.3.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "unicode-case-folding": "1.1.1",
