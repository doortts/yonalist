{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Yonalist v2 main window capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
