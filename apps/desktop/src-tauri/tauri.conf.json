{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yonalist",
  "version": "0.2.0",
  "identifier": "com.doortts.yonalist.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/NanumGothic-Regular.ttf",
      "resources/NanumGothic-OFL.txt",
      "resources/Excalifont-OFL.txt",
      "resources/Xiaolai-OFL.txt",
      "resources/NanumPenScript-OFL.txt",
      "resources/FONT_SOURCE.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
